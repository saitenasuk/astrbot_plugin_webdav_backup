{
  "local_enabled": {
    "type": "bool",
    "description": "本地定时备份",
    "default": false
  },
  "local_cron": {
    "type": "string",
    "description": "本地Cron 表达式",
    "default": "0 2 * * *"
  },
  "local_timezone": {
    "type": "string",
    "description": "本地时区",
    "default": "Asia/Shanghai"
  },
  "local_items": {
    "type": "bool",
    "description": "备份 temp 目录",
    "hint": "data/temp 包含运行缓存、临时图片、语音和下载文件。",
    "default": false
  },
  "webdav_enabled": {
    "type": "bool",
    "description": "WebDAV定时备份",
    "default": false
  },
  "webdav_cron": {
    "type": "string",
    "description": "WebDAVCron 表达式",
    "default": "0 3 * * *"
  },
  "webdav_timezone": {
    "type": "string",
    "description": "WebDAV时区",
    "default": "Asia/Shanghai"
  },
  "webdav_items": {
    "type": "bool",
    "description": "备份 temp 目录",
    "hint": "data/temp 包含运行缓存、临时图片、语音和下载文件。",
    "default": false
  },
  "url": {
    "type": "string",
    "description": "WebDAV 服务地址",
    "hint": "包含 WebDAV 入口，例如 https://dav.example.com/dav/。",
    "default": ""
  },
  "remote_dir": {
    "type": "string",
    "description": "远程目录",
    "hint": "相对于服务地址的现有目录。/ 表示服务根目录，例如 /backups 表示其子目录。",
    "default": "/"
  },
  "username": {
    "type": "string",
    "description": "WebDAV 用户名",
    "default": ""
  },
  "password": {
    "type": "string",
    "description": "WebDAV 应用密码",
    "default": "",
    "secret": true,
    "hint": "可改用环境变量 ASTRBOT_WEBDAV_PASSWORD。"
  },
  "allow_http": {
    "type": "bool",
    "description": "允许在可信内网上使用明文 HTTP",
    "default": false
  }
}
