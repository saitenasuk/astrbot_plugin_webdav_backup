{
  "local_enabled": {
    "type": "bool",
    "description": "本地定时备份",
    "default": false
  },
  "local_cron": {
    "type": "string",
    "description": "本地Cron 表达式",
    "default": "0 2 * * *"
  },
  "local_timezone": {
    "type": "string",
    "description": "本地时区",
    "default": "Asia/Shanghai"
  },
  "local_items": {
    "type": "list",
    "description": "本地备份项",
    "default": [
      "config",
      "knowledge_base",
      "attachments",
      "skills",
      "plugins",
      "plugin_data",
      "webchat",
      "t2i_templates"
    ],
    "render_type": "checkbox",
    "options": [
      "config",
      "knowledge_base",
      "attachments",
      "skills",
      "plugins",
      "plugin_data",
      "webchat",
      "t2i_templates",
      "temp"
    ],
    "labels": [
      "配置文件",
      "知识库",
      "附件文件",
      "技能",
      "插件本体",
      "插件数据",
      "WebChat 数据",
      "文生图模板",
      "临时目录 temp"
    ],
    "subtitles": [
      "主配置 cmd_config.json、MCP 配置和 data/config 下的插件配置。",
      "知识库元数据、文档块、FAISS 向量索引和知识库媒体。",
      "主数据库附件记录对应的本地文件。跳过后会话仍保留附件记录。",
      "data/skills 中安装的本地技能及其资源。",
      "data/plugins 中安装的插件代码和资源。",
      "各插件保存在 data/plugin_data 下的数据和资源。",
      "data/webchat 下的文件，会话记录随主库导出。",
      "data/t2i_templates 下的自定义渲染模板。",
      "运行缓存、临时图片、语音和下载文件。维护页的日志和追踪另有存储，默认在 data/logs。"
    ],
    "hint": "主数据库始终包含，用于 AstrBot 原生恢复。"
  },
  "webdav_enabled": {
    "type": "bool",
    "description": "WebDAV定时备份",
    "default": false
  },
  "webdav_cron": {
    "type": "string",
    "description": "WebDAVCron 表达式",
    "default": "0 3 * * *"
  },
  "webdav_timezone": {
    "type": "string",
    "description": "WebDAV时区",
    "default": "Asia/Shanghai"
  },
  "webdav_items": {
    "type": "list",
    "description": "WebDAV备份项",
    "default": [
      "config",
      "knowledge_base",
      "attachments",
      "skills",
      "plugins",
      "plugin_data",
      "webchat",
      "t2i_templates"
    ],
